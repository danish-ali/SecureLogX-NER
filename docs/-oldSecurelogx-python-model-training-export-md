## 13. Recommended Final Command Sequence

```bash
# 1. Prepare base labeled dataset
python scripts/prep_kaggle_pii.py \
  --in data/raw/base_pii_dataset.csv \
  --out data/kaggle_pii/pii_hf

# 2. Train baseline model
python scripts/train_baseline.py \
  --train data/kaggle_pii/pii_hf/train.jsonl \
  --dev data/kaggle_pii/pii_hf/dev.jsonl \
  --test data/kaggle_pii/pii_hf/test.jsonl \
  --labels data/kaggle_pii/pii_hf/labels.json \
  --out models/pii_baseline

# 3. Normalize raw unlabeled logs
python scripts/normalize_unlabeled.py \
  --in data/raw/unlabeled.txt \
  --out data/to_annotate/pool.jsonl

# 4. Clean logs to message text
python scripts/clean_logs_to_messages.py \
  data/to_annotate/pool.jsonl \
  data/to_annotate/pool_norm.jsonl

# 5. Sample informative records
python scripts/al_sampler.py \
  -i data/to_annotate/pool_norm.jsonl \
  -o data/to_annotate/sample_for_label.jsonl \
  --model-dir models/pii_baseline \
  --limit 500 \
  --format auto \
  --dedupe \
  --seed 42 \
  --use-entropy

# 6. Annotate sampled records
python scripts/annotate_pool.py \
  data/to_annotate/sample_for_label.jsonl \
  data/to_annotate/labeled_pool.jsonl \
  models/pii_baseline \
  --limit 500 \
  --local-only

# 7. Merge labeled datasets
python scripts/merge.py \
  --in \
    data/kaggle_pii/pii_hf/train.jsonl \
    data/kaggle_pii/pii_hf/dev.jsonl \
    data/kaggle_pii/pii_hf/test.jsonl \
    data/to_annotate/labeled_pool.jsonl \
  --out data/training/all_labeled.jsonl

# 8. Split merged labeled dataset
python scripts/split_labeled_jsonl.py \
  --in data/training/all_labeled.jsonl \
  --out data/split

# 9. Retrain final model
python scripts/train_baseline_full.py \
  --train data/split/train.jsonl \
  --dev data/split/dev.jsonl \
  --labels data/kaggle_pii/pii_hf/labels.json \
  --out output_trf

# 10. Evaluate final model
python scripts/eval_hf_charspan.py \
  --model output_trf/model-best \
  --data data/split/test.jsonl

# 11. Export ONNX
python -m optimum.exporters.onnx \
  --model output_trf/model-best \
  --task token-classification \
  --opset 17 \
  onnx/securelogx.onnx

# 12. Copy tokenizer and metadata files
cp output_trf/model-best/tokenizer.json onnx/tokenizer.json
cp output_trf/model-best/tokenizer_config.json onnx/tokenizer_config.json
cp output_trf/model-best/special_tokens_map.json onnx/special_tokens_map.json
cp output_trf/model-best/config.json onnx/hf-config.json
```

